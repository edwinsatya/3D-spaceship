# Optional player accounts (Supabase). Leave empty to run the game guest-only.
# Copy to .env.local and fill in from Supabase → Project Settings → API.
# These are public browser keys; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…); the legacy anon key also works:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
